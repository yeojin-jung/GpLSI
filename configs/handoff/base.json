{
  "description": "Claire Donnat's production protocol of 2026-09-15 for CRC, spleen and Cooking (lambda chosen by graph CV once, then held fixed; SVS/SVS* with adaptive MixedSCORE L). Kept to reproduce the handoff runs; the paper protocol is configs/base.json.",
  "output_root": "results",
  "heldout_fraction": 0.2,
  "spectral": {
    "lamb_start": 0.0001,
    "step_size": 1.2,
    "grid_len": 29,
    "maxiter": 50,
    "eps": 1e-05,
    "nfolds": 5,
    "n_jobs": 1,
    "cv_fold_mode": "all",
    "lambda_selection_mode": "cv_once",
    "initialization": "weighted_debiased_mean_N_approx"
  },
  "A_recoveries": [
    "A_current",
    "A_full_Pois"
  ],
  "recovery": {
    "poisson_max_iter": 2000,
    "poisson_tolerance": 1e-08,
    "poisson_start": "pooled"
  },
  "condition_threshold": 1000000000000.0,
  "vertex_parameters": {
    "svs": {
      "L_mode": "mixedscore_adaptive",
      "max_simplexes": 200000
    },
    "svs_star": {
      "L_mode": "mixedscore_adaptive",
      "max_simplexes": 200000
    },
    "palm": {
      "lambda_": 1.0,
      "max_iterations": 300,
      "tolerance": 1e-07,
      "c_h": 1.1,
      "c_w": 1.1,
      "projection_tolerance": 1e-10,
      "projection_max_iterations": 10000,
      "hull_reduction": "none",
      "initialize_weights_iterations": 200,
      "final_weight_refit_iterations": 200,
      "initialization_precondition": false
    },
    "palm_accelerated": {
      "lambda_": 1.0,
      "max_iterations": 300,
      "tolerance": 1e-07,
      "c_h": 1.1,
      "c_w": 1.1,
      "projection_tolerance": 1e-10,
      "projection_max_iterations": 10000,
      "hull_reduction": "none",
      "initialize_weights_iterations": 200,
      "final_weight_refit_iterations": 200,
      "initialization_precondition": false
    }
  },
  "topicscore_graph_preprocessing": "P0_raw"
}
